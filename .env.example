# Database (Railway provides this automatically)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nokendeclic"

# JWT
JWT_SECRET="your-very-long-and-secure-jwt-secret-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-very-long-and-secure-refresh-token-secret-key-here"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://your-railway-app.railway.app/auth/google/callback"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# App (PORT is set automatically by Railway)
PORT=3000
FRONTEND_URL="https://your-frontend-url.com"

# ---------------------------------------------------------------------------
# Stockage des fichiers — Cloudflare R2 (API compatible S3)
# ---------------------------------------------------------------------------
# Les fichiers utilisateurs (pièces jointes d'offres, documents, photos de
# profil) sont stockés sur R2. Ils étaient auparavant écrits sur le disque du
# conteneur, réinitialisé à chaque déploiement Railway — ce qui a entraîné la
# perte de l'intégralité des fichiers déjà envoyés.
#
# Où trouver ces valeurs, dans le tableau de bord Cloudflare :
#   R2_ACCOUNT_ID        R2 > Overview, « Account ID » (aussi dans l'URL du
#                        tableau de bord). Ce n'est PAS l'identifiant du bucket.
#   R2_ACCESS_KEY_ID     R2 > Manage API Tokens > le jeton créé ; « Access Key ID »
#   R2_SECRET_ACCESS_KEY le « Secret Access Key » du même jeton (affiché une
#                        seule fois à la création)
#   R2_BUCKET            nom exact du bucket
#   R2_PUBLIC_URL        URL publique de lecture du bucket, SANS barre oblique
#                        finale. Soit un domaine personnalisé connecté au bucket
#                        (recommandé), soit l'URL r2.dev si l'accès public
#                        est activé sur le bucket.
#
# Le jeton d'API doit avoir la permission « Object Read & Write » limitée à ce
# seul bucket.
#
# Ces valeurs se renseignent dans Railway > service backend > Variables.
# Ne jamais les écrire dans un fichier versionné.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://fichiers.votre-domaine.com"

# Taille maximale d'un fichier envoyé, en octets (10 Mo par défaut)
MAX_FILE_SIZE=10485760

# Mail (vérification d'email, réinitialisation de mot de passe)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Noken Declic <your-email@gmail.com>"
